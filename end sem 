<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodExpress - Online Food Delivery</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f8f8f8;
        }

        /* Navbar */
        nav {
            background-color: #ff4d4d;
            color: white;
            padding: 18px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h1 {
            font-size: 28px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            font-size: 17px;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(to right, #ff9966, #ff5e62);
            color: white;
            text-align: center;
            padding: 70px 20px;
        }

        .hero h2 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 20px;
            margin-bottom: 25px;
        }

        .search {
            width: 60%;
            padding: 15px;
            border: none;
            border-radius: 25px;
            font-size: 16px;
        }

        /* Categories */
        .categories {
            text-align: center;
            padding: 35px;
        }

        .categories h2 {
            margin-bottom: 20px;
        }

        .category {
            display: inline-block;
            background-color: white;
            padding: 15px 25px;
            margin: 8px;
            border-radius: 20px;
            cursor: pointer;
            box-shadow: 0 2px 8px #ccc;
        }

        .category:hover {
            background-color: #ff4d4d;
            color: white;
        }

        /* Food Section */
        .food-section {
            padding: 30px 50px;
        }

        .food-section h2 {
            text-align: center;
            margin-bottom: 30px;
        }

        .food-container {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .food-card {
            background-color: white;
            width: 280px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 10px #ccc;
        }

        .food-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .food-info {
            padding: 18px;
        }

        .food-info h3 {
            margin-bottom: 8px;
        }

        .food-info p {
            color: #666;
            margin-bottom: 10px;
        }

        .price {
            font-size: 18px;
            font-weight: bold;
            color: #ff4d4d;
        }

        button {
            background-color: #ff4d4d;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 5px;
            cursor: pointer;
            float: right;
        }

        button:hover {
            background-color: #d93636;
        }

        /* Footer */
        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 25px;
            margin-top: 40px;
        }

        /* Mobile */
        @media(max-width: 600px) {
            nav {
                padding: 15px;
                flex-direction: column;
                gap: 10px;
            }

            .search {
                width: 90%;
            }

            .food-section {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav>
        <h1>🍔 FoodExpress</h1>

        <div>
            <a href="#">Home</a>
            <a href="#food">Food</a>
            <a href="#categories">Categories</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <h2>Delicious Food Delivered Fast!</h2>
        <p>Order your favorite food from the best restaurants near you.</p>

        <input
            type="text"
            class="search"
            id="searchBox"
            placeholder="Search for food..."
            onkeyup="searchFood()">
    </section>

    <!-- Categories -->
    <section class="categories" id="categories">
        <h2>Food Categories</h2>

        <div class="category">🍕 Pizza</div>
        <div class="category">🍔 Burgers</div>
        <div class="category">🍗 Chicken</div>
        <div class="category">🍛 Biryani</div>
        <div class="category">🥗 Salads</div>
        <div class="category">🍰 Desserts</div>
    </section>

    <!-- Food Items -->
    <section class="food-section" id="food">

        <h2>Popular Food Items</h2>

        <div class="food-container">

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1574071318508-1cdbab80d002" alt="Pizza">

                <div class="food-info">
                    <h3>Cheese Pizza</h3>
                    <p>Delicious cheesy pizza with fresh toppings.</p>

                    <span class="price">₹299</span>

                    <button onclick="addToCart('Cheese Pizza', 299)">
                        Add
                    </button>
                </div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd" alt="Burger">

                <div class="food-info">
                    <h3>Chicken Burger</h3>
                    <p>Juicy chicken burger with fresh vegetables.</p>

                    <span class="price">₹199</span>

                    <button onclick="addToCart('Chicken Burger', 199)">
                        Add
                    </button>
                </div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1563379091339-03246963d96c" alt="Biryani">

                <div class="food-info">
                    <h3>Chicken Biryani</h3>
                    <p>Authentic and delicious Indian chicken biryani.</p>

                    <span class="price">₹249</span>

                    <button onclick="addToCart('Chicken Biryani', 249)">
                        Add
                    </button>
                </div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1551024506-0bccd828d307" alt="Dessert">

                <div class="food-info">
                    <h3>Chocolate Cake</h3>
                    <p>Soft and delicious chocolate cake.</p>

                    <span class="price">₹149</span>

                    <button onclick="addToCart('Chocolate Cake', 149)">
                        Add
                    </button>
                </div>
            </div>

        </div>
    </section>

    <!-- Cart -->
    <section style="text-align:center; padding:30px;">
        <h2>🛒 Your Cart</h2>

        <p id="cartItems">Cart is empty</p>

        <h3>Total: ₹<span id="total">0</span></h3>

        <br>

        <button onclick="placeOrder()">Place Order</button>
    </section>

    <!-- Footer -->
    <footer id="contact">
        <h3>FoodExpress</h3>
        <p>Online Food Delivery System</p>
        <p>Email: foodexpress@example.com</p>
        <p>©️ 2026 FoodExpress. All Rights Reserved.</p>
    </footer>


    <script>

        let cart = [];
        let total = 0;

        // Add food to cart
        function addToCart(name, price) {

            cart.push(name);
            total = total + price;

            document.getElementById("cartItems").innerHTML =
                cart.join("<br>");

            document.getElementById("total").innerHTML = total;
        }


        // Place order
        function placeOrder() {

            if (cart.length === 0) {
                alert("Please add food to your cart first!");
            }
            else {
                alert(
                    "Order placed successfully! 🍔\nTotal Amount: ₹" + total
                );

                cart = [];
                total = 0;

                document.getElementById("cartItems").innerHTML =
                    "Cart is empty";

                document.getElementById("total").innerHTML = "0";
            }
        }


        // Search food
        function searchFood() {

            let input =
                document.getElementById("searchBox").value.toLowerCase();

            let cards =
                document.getElementsByClassName("food-card");

            for (let i = 0; i < cards.length; i++) {

                let name =
                    cards[i].getElementsByTagName("h3")[0]
                    .innerText.toLowerCase();

                if (name.includes(input)) {
                    cards[i].style.display = "block";
                }
                else {
                    cards[i].style.display = "none";
                }
            }
        }

    </script>

